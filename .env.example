# Session configuration for the shell.
#
# This file holds only values the shell needs. Terraform inputs live in
# terraform/<root>/terraform.tfvars and are deliberately not duplicated here.
#
# Load it with:   . .\scripts\env.ps1      (PowerShell)
#                 source scripts/env.sh    (bash / WSL)
#
# Nothing here is a secret. If a value ever is, it does not belong in this file.

# AWS profile used by the AWS CLI and Terraform on your machine.
# Uses whatever is in ~/.aws/credentials or an SSO session. No access keys in the repo.
AWS_PROFILE=default

# Default region for CLI calls. Terraform sets its own regions per provider.
AWS_REGION=us-east-1

# Name prefix for every resource and every cost-allocation tag.
PROJECT=drlab

# Region holding the Terraform state bucket.
TF_STATE_REGION=us-east-1

# Filled in after: terraform -chdir=terraform/bootstrap apply
TF_STATE_BUCKET=
